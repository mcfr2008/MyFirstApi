{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=myfirstapi_db;Username=postgres;Password=1234@Postgres"
  },
  "Jwt": {
    "Key": "ThisIsAMySuperSecretKeyForJwtAuthenticationInMyFirstApi",
    "Issuer": "MyFirstApi",
    "Audience": "MyFirstApiClient"
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "FileStorage": {
    "RootPath": "App_Data/files"
  },
  "Idempotency": {
    "RetentionHours": 24
  },
  "RateLimiting": {
    "PublicTracking": {
      "PermitLimit": 30,
      "WindowSeconds": 60
    }
  }
}
