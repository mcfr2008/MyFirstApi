meta {
  name: Report item lost
  type: http
  seq: 23
}

post {
  url: {{baseUrl}}/api/TrackingEvents
  body: json
  auth: inherit
}

body:json {
  {
    "tagCode": "{{itemTagCode}}",
    "eventTypeCode": "LOST",
    "reasonCode": "MISSING_AT_SCAN"
  }
}

assert {
  res.status: eq 201
}

script:post-response {
  bru.setVar("lostEventId", res.body.id);
}
