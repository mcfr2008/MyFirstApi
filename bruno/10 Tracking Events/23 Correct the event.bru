meta {
  name: Correct the event
  type: http
  seq: 23
}

post {
  url: {{baseUrl}}/api/TrackingEvents/{{wrongEventId}}/correct
  body: json
  auth: inherit
}

body:json {
  {
    "reason": "Scanner had the wrong hub selected",
    "locationId": {{locationId}}
  }
}

assert {
  res.status: eq 200
  res.body.voided.isVoided: eq true
  res.body.voided.voidReason: isString
  res.body.replacement.eventType.code: eq "ARRIVED_AT_HUB"
}

tests {
  test("replacement is linked to the voided event", function () {
    expect(res.body.replacement.replacesEventId).to.equal(bru.getVar("wrongEventId"));
    expect(res.body.voided.replacedByEventId).to.equal(res.body.replacement.id);
    expect(res.body.replacement.location.id).to.equal(bru.getVar("locationId"));
  });
}

docs {
  Voids the original and records a replacement (other fields copied from the original).
}
