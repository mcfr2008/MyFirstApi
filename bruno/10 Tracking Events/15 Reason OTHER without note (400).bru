meta {
  name: Reason OTHER without note (400)
  type: http
  seq: 15
}

post {
  url: {{baseUrl}}/api/TrackingEvents
  body: json
  auth: inherit
}

body:json {
  {
    "tagCode": "{{itemTagCode}}",
    "eventTypeCode": "DELIVERY_FAILED",
    "reasonCode": "OTHER"
  }
}

assert {
  res.status: eq 400
}
