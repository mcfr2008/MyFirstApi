meta {
  name: Create pallet
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/Containers
  body: json
  auth: inherit
}

body:json {
  {
    "code": "PAL-{{runId}}",
    "type": "Pallet",
    "currentLocationId": {{locationId}}
  }
}

assert {
  res.status: eq 201
}

script:post-response {
  bru.setVar("palletId", res.body.id);
}
