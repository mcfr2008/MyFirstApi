meta {
  name: Create customer address - Tokyo
  type: http
  seq: 9
}

post {
  url: {{baseUrl}}/api/Locations
  body: json
  auth: inherit
}

body:json {
  {
    "code": "JP-CUST-{{runId}}",
    "name": "Tokyo customer warehouse",
    "type": "CustomerAddress",
    "addressLine": "1-1 Shibaura, Minato-ku",
    "country": "JP",
    "timeZone": "Asia/Tokyo"
  }
}

assert {
  res.status: eq 201
}

script:post-response {
  bru.setVar("jpCustomerLocId", res.body.id);
}
