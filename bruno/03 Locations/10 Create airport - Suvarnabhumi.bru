meta {
  name: Create airport - Suvarnabhumi
  type: http
  seq: 10
}

post {
  url: {{baseUrl}}/api/Locations
  body: json
  auth: inherit
}

body:json {
  {
    "code": "BKK-APT-{{runId}}",
    "name": "ท่าอากาศยานสุวรรณภูมิ",
    "type": "Airport",
    "country": "TH",
    "iataCode": "BKK",
    "unLocode": "THBKK"
  }
}

assert {
  res.status: eq 201
  res.body.iataCode: eq "BKK"
}
