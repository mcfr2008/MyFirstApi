meta {
  name: Create port - Laem Chabang
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/api/Locations
  body: json
  auth: inherit
}

body:json {
  {
    "code": "THLCH-{{runId}}",
    "name": "ท่าเรือแหลมฉบัง",
    "type": "Port",
    "province": "ชลบุรี",
    "country": "TH",
    "unLocode": "THLCH",
    "timeZone": "Asia/Bangkok"
  }
}

assert {
  res.status: eq 201
  res.body.unLocode: eq "THLCH"
}

script:post-response {
  bru.setVar("portThId", res.body.id);
}
