meta {
  name: Create - invalid time zone (400)
  type: http
  seq: 12
}

post {
  url: {{baseUrl}}/api/v1/Locations
  body: json
  auth: inherit
}

body:json {
  {
    "code": "MARS-{{runId}}",
    "name": "Olympus Mons",
    "type": "Other",
    "timeZone": "Mars/Olympus"
  }
}

assert {
  res.status: eq 400
}
