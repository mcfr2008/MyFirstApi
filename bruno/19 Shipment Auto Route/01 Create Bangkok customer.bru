meta {
  name: Create Bangkok customer
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/Locations
  body: json
  auth: inherit
}

body:json {
  {
    "code": "AR-CUST-{{runId}}",
    "name": "Bangkok sender",
    "type": "CustomerAddress",
    "province": "กรุงเทพ RP-{{runId}}",
    "country": "TH",
    "timeZone": "Asia/Bangkok"
  }
}

assert {
  res.status: eq 201
}

script:post-response {
  bru.setVar("arSenderLocId", res.body.id);
}
