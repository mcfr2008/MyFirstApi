meta {
  name: Create shipment without legs
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/v1/Shipments
  body: json
  auth: inherit
}

body:json {
  {
    "senderPartyId": {{partyId}},
    "receiverPartyId": {{receiverPartyId}},
    "originLocationId": {{arSenderLocId}},
    "destinationLocationId": {{rpCustId}},
    "plannedPickupAt": "2026-10-02T13:00:00+07:00",
    "tagCodes": [
      "{{arItemTag}}"
    ]
  }
}

assert {
  res.status: eq 201
  res.body.legs.length: eq 0
}

script:post-response {
  bru.setVar("arShipmentId", res.body.id);
}
