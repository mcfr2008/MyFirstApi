meta {
  name: Route - unknown lane (400)
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/api/v1/Shipments/{{arShipmentId}}/route
  body: json
  auth: inherit
}

body:json {
  {
    "laneIds": [
      999999
    ]
  }
}

assert {
  res.status: eq 400
  res.body.code: eq "ROUTE_LANE_NOT_AVAILABLE"
}
