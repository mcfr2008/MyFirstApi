meta {
  name: Create item
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/TrackedItems
  body: json
  auth: inherit
}

body:json {
  {
    "name": "Auto-route parcel {{runId}}",
    "weightKg": 12
  }
}

assert {
  res.status: eq 201
}

script:post-response {
  bru.setVar("arItemTag", res.body.tagCode);
}
