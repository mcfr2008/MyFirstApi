meta {
  name: Create airline
  type: http
  seq: 8
}

post {
  url: {{baseUrl}}/api/v1/Carriers
  body: json
  auth: inherit
}

body:json {
  {
    "code": "AIR-{{runId}}",
    "name": "Example Airways Cargo",
    "modes": ["Air"],
    "iataCode": "EX"
  }
}

assert {
  res.status: eq 201
  res.body.iataCode: eq "EX"
}
