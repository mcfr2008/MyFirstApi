meta {
  name: Create
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/Carriers
  body: json
  auth: inherit
}

body:json {
  {
    "code": "SEALINE-{{runId}}",
    "name": "Example Shipping Line",
    "modes": ["Sea"],
    "scacCode": "EXSL",
    "website": "https://shipping.example.com",
    "trackingUrlTemplate": "https://shipping.example.com/track?bl={number}"
  }
}

assert {
  res.status: eq 201
}

script:post-response {
  bru.setVar("carrierId", res.body.id);
  bru.setVar("carrierCode", res.body.code);
}
