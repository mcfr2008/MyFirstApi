meta {
  name: Create road carrier
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/api/v1/Carriers
  body: json
  auth: inherit
}

body:json {
  {
    "code": "TRUCK-{{runId}}",
    "name": "ขนส่งด่วน จำกัด",
    "modes": ["Road", "Courier"],
    "phone": "021112222"
  }
}

assert {
  res.status: eq 201
}

script:post-response {
  bru.setVar("roadCarrierId", res.body.id);
}
