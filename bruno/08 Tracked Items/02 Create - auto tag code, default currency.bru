meta {
  name: Create - auto tag code, default currency
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/TrackedItems
  body: json
  auth: inherit
}

body:json {
  {
    "name": "Document envelope",
    "currentLocationId": {{locationId}},
    "declaredValue": 500
  }
}

assert {
  res.status: eq 201
  res.body.currency: eq "THB"
}

tests {
  test("tag code generated", function () {
    expect(res.body.tagCode).to.match(/^TT-[A-Z0-9]{10}$/);
  });
}
