meta {
  name: Shipment B stays in transit
  type: http
  seq: 17
}

get {
  url: {{baseUrl}}/api/v1/Shipments/{{arBShipmentId}}
  body: none
  auth: inherit
}

assert {
  res.status: eq 200
  res.body.status: eq "InTransit"
  res.body.failedDeliveryAttempts: eq 3
  res.body.returnShipment: isNull
}
