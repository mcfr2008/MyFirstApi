meta {
  name: Shipment A - attempt 2 failed
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/api/v1/Shipments/{{arAShipmentId}}/events
  body: json
  auth: inherit
}

body:json {
  {
    "eventTypeCode": "DELIVERY_FAILED",
    "reasonCode": "RECIPIENT_ABSENT",
    "locationId": {{rpCustId}},
    "occurredAt": "{{arAAttempt2}}"
  }
}

script:pre-request {
  bru.setVar("arAAttempt2", new Date(Date.now() - 20 * 60 * 1000).toISOString());
}

assert {
  res.status: eq 200
  res.body.returnTrackingNumber: isDefined
}

script:post-response {
  bru.setVar("arAReturnTrackingNumber", res.body.returnTrackingNumber);
}

docs {
  The 2nd failed attempt reaches the limit: the shipment is returned to sender in the same request.
}
