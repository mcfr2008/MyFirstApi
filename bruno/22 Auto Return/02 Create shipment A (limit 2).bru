meta {
  name: Create shipment A (limit 2)
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/Shipments
  body: json
  auth: inherit
}

body:json {
  {
    "senderPartyId": {{partyId}},
    "receiverPartyId": {{receiverPartyId}},
    "originLocationId": {{arSenderLocId}},
    "destinationLocationId": {{rpCustId}},
    "plannedPickupAt": "2026-10-02T13:00:00+07:00",
    "tagCodes": [
      "{{arATag}}"
    ],
    "maxDeliveryAttempts": 2
  }
}

assert {
  res.status: eq 201
  res.body.maxDeliveryAttempts: eq 2
}

script:post-response {
  bru.setVar("arAShipmentId", res.body.id);
  bru.setVar("arATrackingNumber", res.body.trackingNumber);
}
