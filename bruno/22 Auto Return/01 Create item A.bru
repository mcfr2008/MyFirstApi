meta {
  name: Create item A
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/TrackedItems
  body: json
  auth: inherit
}

body:json {
  {
    "name": "Auto return A {{runId}}"
  }
}

assert {
  res.status: eq 201
}

script:post-response {
  bru.setVar("arATag", res.body.tagCode);
  bru.setVar("arAItemId", res.body.id);
}
