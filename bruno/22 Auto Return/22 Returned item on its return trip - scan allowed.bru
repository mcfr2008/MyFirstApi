meta {
  name: Returned item on its return trip - scan allowed
  type: http
  seq: 22
}

post {
  url: {{baseUrl}}/api/v1/TrackingEvents/scan
  body: json
  auth: inherit
}

body:json {
  {
    "tagCodes": [
      "{{arATag}}"
    ],
    "eventTypeCode": "ARRIVED_AT_HUB",
    "locationId": {{rpCnxBrId}}
  }
}

assert {
  res.status: eq 201
  res.body.events[0].offRouteShipment: isNull
}

docs {
  RETURNED is terminal too, but the item joined the open return shipment afterwards, so its journey continues (and Chiang Mai branch is on the return route).
}
