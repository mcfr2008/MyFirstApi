meta {
  name: Create item B
  type: http
  seq: 10
}

post {
  url: {{baseUrl}}/api/v1/TrackedItems
  body: json
  auth: inherit
}

body:json {
  {
    "name": "Auto return B {{runId}}"
  }
}

assert {
  res.status: eq 201
}

script:post-response {
  bru.setVar("arBTag", res.body.tagCode);
  bru.setVar("arBItemId", res.body.id);
}
