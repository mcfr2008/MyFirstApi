meta {
  name: List
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/ItemCategories?search=elec&page=1&pageSize=20
  body: none
  auth: inherit
}

params:query {
  search: elec
  page: 1
  pageSize: 20
}

assert {
  res.status: eq 200
  res.body.items: isArray
  res.body.totalCount: isNumber
}
