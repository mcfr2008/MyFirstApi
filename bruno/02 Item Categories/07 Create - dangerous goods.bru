meta {
  name: Create - dangerous goods
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/api/ItemCategories
  body: json
  auth: inherit
}

body:json {
  {
    "code": "DG-PAINT-{{runId}}",
    "name": "Paint (flammable liquid)",
    "isDangerousGoods": true,
    "unNumber": "UN1263",
    "hazardClass": "3"
  }
}

assert {
  res.status: eq 201
  res.body.isDangerousGoods: eq true
  res.body.unNumber: eq "UN1263"
}
