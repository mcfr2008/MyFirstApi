meta {
  name: Create Laem Chabang port
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/Locations
  body: json
  auth: inherit
}

body:json {
  {
    "code": "CF-LCB-{{runId}}",
    "name": "Laem Chabang Port",
    "type": "Port",
    "country": "TH",
    "timeZone": "Asia/Bangkok",
    "latitude": 13.08,
    "longitude": 100.88
  }
}

assert {
  res.status: eq 201
}

script:post-response {
  bru.setVar("cfLcbId", res.body.id);
}
