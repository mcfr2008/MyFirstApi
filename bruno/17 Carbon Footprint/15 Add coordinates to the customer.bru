meta {
  name: Add coordinates to the customer
  type: http
  seq: 15
}

put {
  url: {{baseUrl}}/api/v1/Locations/{{cfCustId}}
  body: json
  auth: inherit
}

body:json {
  {
    "code": "CF-CUST-{{runId}}",
    "name": "Tokyo customer",
    "type": "CustomerAddress",
    "country": "JP",
    "timeZone": "Asia/Tokyo",
    "latitude": 35.64,
    "longitude": 139.75
  }
}

assert {
  res.status: eq 200
}
