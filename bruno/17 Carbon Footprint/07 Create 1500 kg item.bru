meta {
  name: Create 1500 kg item
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/api/v1/TrackedItems
  body: json
  auth: inherit
}

body:json {
  {
    "name": "Machine body {{runId}}",
    "weightKg": 1500,
    "currentLocationId": {{cfBkkId}}
  }
}

assert {
  res.status: eq 201
}

script:post-response {
  bru.setVar("cfItem2Tag", res.body.tagCode);
}
