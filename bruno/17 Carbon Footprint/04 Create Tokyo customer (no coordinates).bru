meta {
  name: Create Tokyo customer (no coordinates)
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/api/v1/Locations
  body: json
  auth: inherit
}

body:json {
  {
    "code": "CF-CUST-{{runId}}",
    "name": "Tokyo customer",
    "type": "CustomerAddress",
    "country": "JP",
    "timeZone": "Asia/Tokyo"
  }
}

assert {
  res.status: eq 201
}

script:post-response {
  bru.setVar("cfCustId", res.body.id);
}
