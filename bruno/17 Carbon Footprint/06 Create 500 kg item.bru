meta {
  name: Create 500 kg item
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/api/v1/TrackedItems
  body: json
  auth: inherit
}

body:json {
  {
    "name": "Machine parts {{runId}}",
    "weightKg": 500,
    "currentLocationId": {{cfBkkId}}
  }
}

assert {
  res.status: eq 201
}

script:post-response {
  bru.setVar("cfItem1Tag", res.body.tagCode);
}
