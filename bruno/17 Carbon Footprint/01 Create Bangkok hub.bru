meta {
  name: Create Bangkok hub
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/Locations
  body: json
  auth: inherit
}

body:json {
  {
    "code": "CF-BKK-{{runId}}",
    "name": "Hub ลาดกระบัง",
    "type": "Hub",
    "country": "TH",
    "timeZone": "Asia/Bangkok",
    "latitude": 13.7,
    "longitude": 100.75
  }
}

assert {
  res.status: eq 201
}

script:post-response {
  bru.setVar("cfBkkId", res.body.id);
}
