meta {
  name: List
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/v1/ReasonCodes?eventTypeCode=DELIVERY_FAILED&pageSize=50
  body: none
  auth: inherit
}

params:query {
  eventTypeCode: DELIVERY_FAILED
  pageSize: 50
}

assert {
  res.status: eq 200
  res.body.items: isArray
  res.body.totalCount: isNumber
}
