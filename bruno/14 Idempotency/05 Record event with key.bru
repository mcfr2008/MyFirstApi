meta {
  name: Record event with key
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/api/v1/TrackingEvents
  body: json
  auth: inherit
}

headers {
  Idempotency-Key: arrive-{{runId}}
}

body:json {
  {
    "trackedItemId": {{idemItemId}},
    "eventTypeCode": "ARRIVED_AT_HUB",
    "locationId": {{locationId}}
  }
}

assert {
  res.status: eq 201
}

script:post-response {
  bru.setVar("idemEventId", res.body.id);
}
