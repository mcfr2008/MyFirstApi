meta {
  name: Update archived item (409)
  type: http
  seq: 16
}

put {
  url: {{baseUrl}}/api/TrackedItems/{{itemId}}
  body: json
  auth: inherit
}

body:json {
  {
    "tagCode": "{{itemTagCode}}",
    "name": "Should fail",
    "categoryId": {{categoryId}},
    "attributes": { "serialNumber": "SN-{{runId}}" }
  }
}

assert {
  res.status: eq 409
}
