meta {
  name: Update
  type: http
  seq: 14
}

put {
  url: {{baseUrl}}/api/TrackedItems/{{itemId}}
  body: json
  auth: inherit
}

body:json {
  {
    "tagCode": "{{itemTagCode}}",
    "name": "Notebook Dell XPS 13 (2026)",
    "description": "PUT replaces all fields - send the full item. Location changes only via events.",
    "categoryId": {{categoryId}},
    "ownerPartyId": {{partyId}},
    "weightKg": 1.25,
    "declaredValue": 1250,
    "currency": "USD",
    "hsCode": "8471.30",
    "originCountry": "CN",
    "attributes": {
      "serialNumber": "SN-{{runId}}",
      "color": "black"
    }
  }
}

assert {
  res.status: eq 200
}
