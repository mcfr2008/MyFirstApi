meta {
  name: Create - missing required attribute (400)
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/api/v1/TrackedItems
  body: json
  auth: inherit
}

body:json {
  {
    "name": "Phone without serial number",
    "categoryId": {{categoryId}}
  }
}

assert {
  res.status: eq 400
  res.body.code: eq "ITEM_MISSING_REQUIRED_ATTRIBUTES"
}

docs {
  The category requires `serialNumber` in attributes.
}
