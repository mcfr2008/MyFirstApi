meta {
  name: Scan pallet at Phitsanulok - back on route
  type: http
  seq: 16
}

post {
  url: {{baseUrl}}/api/v1/Containers/{{mdPalletId}}/scan
  body: json
  auth: inherit
}

body:json {
  {
    "eventTypeCode": "ARRIVED_AT_HUB",
    "locationId": {{rpPlkId}}
  }
}

assert {
  res.status: eq 200
  res.body.offRouteEvents: eq 0
}
