meta {
  name: Create shipment Bangna - Chiang Mai
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/api/v1/Shipments
  body: json
  auth: inherit
}

body:json {
  {
    "senderPartyId": {{partyId}},
    "receiverPartyId": {{receiverPartyId}},
    "originLocationId": {{rpBnaId}},
    "destinationLocationId": {{rpCnxBrId}},
    "plannedPickupAt": "2026-10-02T15:00:00+07:00",
    "tagCodes": [
      "{{mdItemA}}",
      "{{mdItemB}}"
    ]
  }
}

assert {
  res.status: eq 201
}

script:post-response {
  bru.setVar("mdShipmentId", res.body.id);
  bru.setVar("mdTrackingNumber", res.body.trackingNumber);
}
