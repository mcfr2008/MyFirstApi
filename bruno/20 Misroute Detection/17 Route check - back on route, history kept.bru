meta {
  name: Route check - back on route, history kept
  type: http
  seq: 17
}

get {
  url: {{baseUrl}}/api/v1/Shipments/{{mdShipmentId}}/route-check
  body: none
  auth: inherit
}

assert {
  res.status: eq 200
  res.body.isOffRoute: eq false
  res.body.itemsOffRoute.length: eq 0
  res.body.offRouteEvents.length: eq 2
}
