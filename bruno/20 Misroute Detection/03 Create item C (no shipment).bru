meta {
  name: Create item C (no shipment)
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/v1/TrackedItems
  body: json
  auth: inherit
}

body:json {
  {
    "name": "Misroute C {{runId}}"
  }
}

assert {
  res.status: eq 201
}

script:post-response {
  bru.setVar("mdItemC", res.body.tagCode);
}
