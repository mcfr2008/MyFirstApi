meta {
  name: Route check - misrouted
  type: http
  seq: 12
}

get {
  url: {{baseUrl}}/api/v1/Shipments/{{mdShipmentId}}/route-check
  body: none
  auth: inherit
}

assert {
  res.status: eq 200
  res.body.isOffRoute: eq true
  res.body.routePoints.length: eq 5
  res.body.routePoints[2].id: eq {{rpPlkId}}
  res.body.itemsOffRoute.length: eq 2
  res.body.itemsOffRoute[0].currentLocation.id: eq {{rpNsnId}}
  res.body.offRouteEvents.length: eq 2
}
