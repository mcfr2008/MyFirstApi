meta {
  name: Update planned shipment
  type: http
  seq: 32
}

put {
  url: {{baseUrl}}/api/v1/Shipments/{{domesticShipmentId}}
  body: json
  auth: inherit
}

body:json {
  {
    "reference": "INTERNAL-{{runId}}",
    "senderPartyId": {{partyId}},
    "receiverPartyId": {{partyId}},
    "originLocationId": {{locationId}},
    "destinationLocationId": {{portThId}},
    "legs": [
      { "mode": "Road", "originLocationId": {{locationId}}, "destinationLocationId": {{portThId}}, "carrierId": {{roadCarrierId}} }
    ]
  }
}

assert {
  res.status: eq 200
}

tests {
  test("reference and leg updated", function () {
    expect(res.body.reference).to.equal("INTERNAL-" + bru.getVar("runId"));
    expect(res.body.legs.length).to.equal(1);
  });
}
