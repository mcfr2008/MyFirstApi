meta {
  name: Item is delivered at destination
  type: http
  seq: 27
}

get {
  url: {{baseUrl}}/api/v1/TrackedItems/{{itemId}}
  body: none
  auth: inherit
}

assert {
  res.status: eq 200
  res.body.status: eq "Delivered"
}

tests {
  test("current location is the destination", function () {
    expect(res.body.currentLocation.id).to.equal(bru.getVar("jpCustomerLocId"));
  });
}
