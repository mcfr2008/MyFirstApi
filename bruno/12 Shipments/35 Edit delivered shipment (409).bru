meta {
  name: Edit delivered shipment (409)
  type: http
  seq: 35
}

put {
  url: {{baseUrl}}/api/v1/Shipments/{{shipmentId}}
  body: json
  auth: inherit
}

body:json {
  {
    "senderPartyId": {{partyId}},
    "receiverPartyId": {{receiverPartyId}},
    "originLocationId": {{locationId}},
    "destinationLocationId": {{jpCustomerLocId}}
  }
}

assert {
  res.status: eq 409
}
