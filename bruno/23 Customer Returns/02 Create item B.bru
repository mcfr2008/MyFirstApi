meta {
  name: Create item B
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/TrackedItems
  body: json
  auth: inherit
}

body:json {
  {
    "name": "RMA B {{runId}}"
  }
}

assert {
  res.status: eq 201
}

script:post-response {
  bru.setVar("rmaBTag", res.body.tagCode);
  bru.setVar("rmaBItemId", res.body.id);
}
