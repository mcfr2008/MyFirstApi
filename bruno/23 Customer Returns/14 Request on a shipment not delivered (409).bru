meta {
  name: Request on a shipment not delivered (409)
  type: http
  seq: 14
}

post {
  url: {{baseUrl}}/api/v1/Returns
  body: json
  auth: inherit
}

body:json {
  {
    "shipmentId": {{arBShipmentId}},
    "items": [
      {
        "tagCode": "{{arBTag}}",
        "reasonCode": "DEFECTIVE"
      }
    ]
  }
}

assert {
  res.status: eq 409
  res.body.code: eq "SHIPMENT_STATUS_NOT_ALLOWED"
  res.body.args.action: eq "requestReturn"
}

docs {
  Shipment B from 22 is still in transit.
}
