meta {
  name: Request return of C
  type: http
  seq: 18
}

post {
  url: {{baseUrl}}/api/v1/Returns
  body: json
  auth: inherit
}

body:json {
  {
    "shipmentId": {{rmaShipmentId}},
    "items": [
      {
        "tagCode": "{{rmaCTag}}",
        "reasonCode": "NO_LONGER_NEEDED"
      }
    ]
  }
}

assert {
  res.status: eq 201
}

script:post-response {
  bru.setVar("rma2Id", res.body.id);
}
