meta {
  name: Create item D
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/api/v1/TrackedItems
  body: json
  auth: inherit
}

body:json {
  {
    "name": "RMA D {{runId}}"
  }
}

assert {
  res.status: eq 201
}

script:post-response {
  bru.setVar("rmaDTag", res.body.tagCode);
  bru.setVar("rmaDItemId", res.body.id);
}
