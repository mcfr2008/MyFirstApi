meta {
  name: Create shipment with A, B, C
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/api/v1/Shipments
  body: json
  auth: inherit
}

body:json {
  {
    "senderPartyId": {{partyId}},
    "receiverPartyId": {{receiverPartyId}},
    "originLocationId": {{arSenderLocId}},
    "destinationLocationId": {{rpCustId}},
    "requiresSignature": false,
    "tagCodes": [
      "{{rmaATag}}",
      "{{rmaBTag}}",
      "{{rmaCTag}}"
    ]
  }
}

assert {
  res.status: eq 201
}

script:post-response {
  bru.setVar("rmaShipmentId", res.body.id);
}
