meta {
  name: Item A can be scanned on its way back
  type: http
  seq: 17
}

post {
  url: {{baseUrl}}/api/v1/TrackingEvents/scan
  body: json
  auth: inherit
}

body:json {
  {
    "tagCodes": [
      "{{rmaATag}}"
    ],
    "eventTypeCode": "ARRIVED_AT_HUB",
    "locationId": {{rpCnxBrId}}
  }
}

assert {
  res.status: eq 201
  res.body.events[0].offRouteShipment: isNull
}
