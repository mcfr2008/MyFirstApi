meta {
  name: Request return of A and B
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/api/v1/Returns
  body: json
  auth: inherit
}

body:json {
  {
    "shipmentId": {{rmaShipmentId}},
    "note": "Box arrived crushed, and B is the wrong model",
    "items": [
      {
        "tagCode": "{{rmaATag}}",
        "reasonCode": "DAMAGED_ON_ARRIVAL",
        "note": "Corner crushed"
      },
      {
        "tagCode": "{{rmaBTag}}",
        "reasonCode": "WRONG_ITEM"
      }
    ]
  }
}

assert {
  res.status: eq 201
  res.body.status: eq "Requested"
  res.body.items.length: eq 2
  res.body.shipment.id: eq {{rmaShipmentId}}
  res.body.returnShipment: isNull
}

script:post-response {
  bru.setVar("rma1Id", res.body.id);
  bru.setVar("rma1Number", res.body.rmaNumber);
}

docs {
  Each item keeps its own reason; the RMA number is what the customer quotes.
}
