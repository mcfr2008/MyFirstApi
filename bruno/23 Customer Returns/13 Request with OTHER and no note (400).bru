meta {
  name: Request with OTHER and no note (400)
  type: http
  seq: 13
}

post {
  url: {{baseUrl}}/api/v1/Returns
  body: json
  auth: inherit
}

body:json {
  {
    "shipmentId": {{rmaShipmentId}},
    "items": [
      {
        "tagCode": "{{rmaCTag}}",
        "reasonCode": "OTHER"
      }
    ]
  }
}

assert {
  res.status: eq 400
  res.body.code: eq "REASON_NOTE_REQUIRED"
}
