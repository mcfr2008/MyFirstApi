meta {
  name: Request A again (409)
  type: http
  seq: 10
}

post {
  url: {{baseUrl}}/api/v1/Returns
  body: json
  auth: inherit
}

body:json {
  {
    "shipmentId": {{rmaShipmentId}},
    "items": [
      {
        "tagCode": "{{rmaATag}}",
        "reasonCode": "DEFECTIVE"
      }
    ]
  }
}

assert {
  res.status: eq 409
  res.body.code: eq "ITEMS_IN_OPEN_RETURN"
}
