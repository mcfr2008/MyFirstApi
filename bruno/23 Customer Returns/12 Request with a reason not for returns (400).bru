meta {
  name: Request with a reason not for returns (400)
  type: http
  seq: 12
}

post {
  url: {{baseUrl}}/api/v1/Returns
  body: json
  auth: inherit
}

body:json {
  {
    "shipmentId": {{rmaShipmentId}},
    "items": [
      {
        "tagCode": "{{rmaCTag}}",
        "reasonCode": "BUSINESS_CLOSED"
      }
    ]
  }
}

assert {
  res.status: eq 400
  res.body.code: eq "REASON_NOT_ALLOWED_FOR_EVENT"
}
