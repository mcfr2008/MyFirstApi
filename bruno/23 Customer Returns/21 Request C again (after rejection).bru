meta {
  name: Request C again (after rejection)
  type: http
  seq: 21
}

post {
  url: {{baseUrl}}/api/v1/Returns
  body: json
  auth: inherit
}

body:json {
  {
    "shipmentId": {{rmaShipmentId}},
    "items": [
      {
        "tagCode": "{{rmaCTag}}",
        "reasonCode": "DEFECTIVE"
      }
    ]
  }
}

assert {
  res.status: eq 201
}

script:post-response {
  bru.setVar("rma3Id", res.body.id);
}
