meta {
  name: Delivery attempt 2 failed
  type: http
  seq: 11
}

post {
  url: {{baseUrl}}/api/v1/Shipments/{{rtShipmentId}}/events
  body: json
  auth: inherit
}

body:json {
  {
    "eventTypeCode": "DELIVERY_FAILED",
    "reasonCode": "RECIPIENT_ABSENT",
    "locationId": {{rpCustId}},
    "occurredAt": "{{rtAttempt2}}"
  }
}

script:pre-request {
  bru.setVar("rtAttempt2", new Date(Date.now() - 1 * 3600 * 1000).toISOString());
}

assert {
  res.status: eq 200
}
