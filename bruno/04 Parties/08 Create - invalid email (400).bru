meta {
  name: Create - invalid email (400)
  type: http
  seq: 8
}

post {
  url: {{baseUrl}}/api/v1/Parties
  body: json
  auth: inherit
}

body:json {
  {
    "code": "BAD-{{runId}}",
    "name": "Someone",
    "type": "Individual",
    "email": "not-an-email"
  }
}

assert {
  res.status: eq 400
}
