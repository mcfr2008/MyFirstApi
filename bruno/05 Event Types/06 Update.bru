meta {
  name: Update
  type: http
  seq: 6
}

put {
  url: {{baseUrl}}/api/v1/EventTypes/{{eventTypeId}}
  body: json
  auth: inherit
}

body:json {
  {
    "code": "CUSTOM_{{runId}}",
    "nameTh": "ตรวจสอบพิเศษ (แก้ไข)",
    "nameEn": "Special inspection (edited)",
    "resultingStatus": null,
    "isTerminal": false,
    "sortOrder": 45
  }
}

assert {
  res.status: eq 200
}
