meta {
  name: Create
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/EventTypes
  body: json
  auth: inherit
}

body:json {
  {
    "code": "CUSTOM_{{runId}}",
    "nameTh": "ตรวจสอบพิเศษ",
    "nameEn": "Special inspection",
    "description": "Informational event, status unchanged",
    "resultingStatus": null,
    "isTerminal": false,
    "sortOrder": 45
  }
}

assert {
  res.status: eq 201
}

script:post-response {
  bru.setVar("eventTypeId", res.body.id);
  bru.setVar("eventTypeCode", res.body.code);
}
