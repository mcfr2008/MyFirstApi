meta {
  name: Create - IMO on a truck (400)
  type: http
  seq: 9
}

post {
  url: {{baseUrl}}/api/v1/Vehicles
  body: json
  auth: inherit
}

body:json {
  {
    "code": "BAD-TRK-{{runId}}",
    "name": "Truck with IMO",
    "mode": "Road",
    "imoNumber": "9321483"
  }
}

assert {
  res.status: eq 400
}
