meta {
  name: Lane PLK-CNX
  type: http
  seq: 15
}

post {
  url: {{baseUrl}}/api/v1/Lanes
  body: json
  auth: inherit
}

body:json {
  {
    "code": "RP-PLK-CNX-{{runId}}",
    "name": "RP PLK-CNX",
    "originLocationId": {{rpPlkId}},
    "destinationLocationId": {{rpCnxHubId}},
    "mode": "Road",
    "transitTimeMinutes": 270,
    "distanceKm": 300,
    "departureTimes": [
      "06:00"
    ]
  }
}

assert {
  res.status: eq 201
}
