meta {
  name: Create Lat Krabang hub
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/Locations
  body: json
  auth: inherit
}

body:json {
  {
    "code": "RP-LKB-{{runId}}",
    "name": "Lat Krabang hub",
    "type": "Hub",
    "province": "กรุงเทพ RP-{{runId}}",
    "country": "TH",
    "timeZone": "Asia/Bangkok"
  }
}

assert {
  res.status: eq 201
}

script:post-response {
  bru.setVar("rpLkbId", res.body.id);
}
