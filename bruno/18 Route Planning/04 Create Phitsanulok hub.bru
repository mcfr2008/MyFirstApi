meta {
  name: Create Phitsanulok hub
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/api/v1/Locations
  body: json
  auth: inherit
}

body:json {
  {
    "code": "RP-PLK-{{runId}}",
    "name": "Phitsanulok hub",
    "type": "Hub",
    "province": "พิษณุโลก",
    "country": "TH",
    "timeZone": "Asia/Bangkok"
  }
}

assert {
  res.status: eq 201
}

script:post-response {
  bru.setVar("rpPlkId", res.body.id);
}
