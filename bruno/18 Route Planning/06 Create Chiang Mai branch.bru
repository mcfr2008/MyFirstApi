meta {
  name: Create Chiang Mai branch
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/api/v1/Locations
  body: json
  auth: inherit
}

body:json {
  {
    "code": "RP-CNXB-{{runId}}",
    "name": "Chiang Mai branch",
    "type": "Branch",
    "province": "เชียงใหม่ RP-{{runId}}",
    "country": "TH",
    "timeZone": "Asia/Bangkok"
  }
}

assert {
  res.status: eq 201
}

script:post-response {
  bru.setVar("rpCnxBrId", res.body.id);
}
