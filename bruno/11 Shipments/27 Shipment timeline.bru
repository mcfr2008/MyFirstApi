meta {
  name: Shipment timeline
  type: http
  seq: 27
}

get {
  url: {{baseUrl}}/api/TrackingEvents?shipmentId={{shipmentId}}&oldestFirst=true&pageSize=100
  body: none
  auth: inherit
}

params:query {
  shipmentId: {{shipmentId}}
  oldestFirst: true
  pageSize: 100
}

assert {
  res.status: eq 200
  res.body.totalCount: eq 30
}

docs {
  3 items x 10 shipment events: 3 departures, 3 arrivals, customs hold, customs cleared, out for delivery, delivered.
}
