meta {
  name: Customs hold
  type: http
  seq: 15
}

post {
  url: {{baseUrl}}/api/Shipments/{{shipmentId}}/customs
  body: json
  auth: inherit
}

body:json {
  {
    "status": "Hold",
    "note": "Export documents incomplete"
  }
}

assert {
  res.status: eq 200
  res.body.customsStatus: eq "Hold"
}

docs {
  Records CUSTOMS_HOLD for every item (item status becomes OnHold) at the port the shipment reached.
}
