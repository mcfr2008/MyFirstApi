meta {
  name: Create - no postal code or province (400)
  type: http
  seq: 10
}

post {
  url: {{baseUrl}}/api/v1/ServiceAreas
  body: json
  auth: inherit
}

body:json {
  {
    "code": "CNX-BAD3-{{runId}}",
    "name": "Nowhere",
    "country": "TH",
    "stationLocationId": {{saCnxBranchId}},
    "hubLocationId": {{saCnxHubId}}
  }
}

assert {
  res.status: eq 400
  res.body.errors.Province: isDefined
}
