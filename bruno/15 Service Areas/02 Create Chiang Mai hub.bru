meta {
  name: Create Chiang Mai hub
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/Locations
  body: json
  auth: inherit
}

body:json {
  {
    "code": "SA-CNX-HUB-{{runId}}",
    "name": "Hub เชียงใหม่",
    "type": "Hub",
    "province": "{{saProvince}}",
    "country": "TH",
    "timeZone": "Asia/Bangkok"
  }
}

assert {
  res.status: eq 201
}

script:post-response {
  bru.setVar("saCnxHubId", res.body.id);
}
