meta {
  name: Update - move postal code to the hub
  type: http
  seq: 17
}

put {
  url: {{baseUrl}}/api/v1/ServiceAreas/{{saPostalAreaId}}
  body: json
  auth: inherit
}

body:json {
  {
    "code": "CNX-PC-{{runId}}",
    "name": "เมืองเชียงใหม่ {{saPostalCode}} (ส่งจาก hub)",
    "country": "TH",
    "province": "{{saProvince}}",
    "postalCode": "{{saPostalCode}}",
    "stationLocationId": {{saCnxHubId}},
    "hubLocationId": {{saCnxHubId}}
  }
}

assert {
  res.status: eq 200
  res.body.station.id: eq {{saCnxHubId}}
}
